# Console build-time settings (Vite exposes only VITE_* to the browser — never
# put a secret here). On Vercel set these under Project → Settings → Environment
# Variables, or sync them from Doppler (plateletiq-web).

# The API. Locally the console finds it on port 8000 of the same host.
# VITE_API_BASE_URL=https://plateletiq-api.onrender.com/api/v1

# Sentry browser SDK (a DSN is public by design: it only allows sending events).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
