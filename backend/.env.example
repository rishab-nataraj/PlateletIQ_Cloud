# ── PlateletIQ backend configuration ─────────────────────────────────────────
# Copy to .env and fill in (or keep everything in Doppler — see doppler.yaml).
# Every cloud integration below is OPTIONAL: leave it empty and the app keeps
# working, and both GET /api/v1/health and the Cloud services screen say which
# integrations are live. docs/CLOUD_SERVICES.md explains each one;
# docs/DEPLOYMENT.md walks through creating the free accounts.

APP_ENV=development

# ── Secrets ──────────────────────────────────────────────────────────────────
# MUST be set and MUST stay stable across restarts, or every session and every
# outstanding OTP dies on restart.
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
OTP_SECRET=
# Shared secret for POST /api/v1/jobs/* from GitHub Actions or curl.
JOBS_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Where this API lives ─────────────────────────────────────────────────────
# The public URL. QStash and Telegram call back into it. On Render this is
# detected automatically from RENDER_EXTERNAL_URL.
# PUBLIC_API_URL=https://plateletiq-api.onrender.com
FRONTEND_URL=http://localhost:5173

# ── Database: Supabase PostgreSQL ────────────────────────────────────────────
# SQLite is fine on one laptop. In the cloud use Supabase: Project → Connect →
# "Session pooler" URI (IPv4-compatible, works from Render), e.g.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./plateletiq.db

# ── Supabase Storage (uploaded demand history, certificate fallback) ─────────
# Project Settings → API. The service-role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plateletiq-files

# ── Browser origins allowed to call this API ─────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Or match a whole range at once (regex), e.g. every Vercel preview:
# ALLOWED_ORIGIN_REGEX=https://plateletiq.*\.vercel\.app

# ── Google sign-in (Google Cloud OAuth 2.0) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Passwordless local sign-in for testing. Leave 0 anywhere real.
ALLOW_DEV_SIGNIN=0

# ── Upstash Redis (cache, locks, rate limits) ────────────────────────────────
# console.upstash.com → Redis → your database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash QStash (notification queue + cron schedules) ─────────────────────
# console.upstash.com → QStash. Needs PUBLIC_API_URL so it can call back.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only if the console shows a regional URL for your account:
# QSTASH_URL=https://qstash.upstash.io

# ── Pusher Channels (live updates) ───────────────────────────────────────────
# dashboard.pusher.com → Channels → your app → App Keys. Client events are not
# needed. Use the cluster nearest your users (ap2 = Mumbai).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# ── Email (tried in this order; only configured providers take part) ────────
EMAIL_PROVIDERS=gmail,brevo,resend,ses
EMAIL_FROM_NAME=PlateletIQ Alerts
# Optional demo safety net: only these addresses / @domains receive mail.
# EMAIL_ALLOWLIST=@gmail.com,professor@university.edu

# Gmail API: sends as your own Gmail. Run scripts/gmail_refresh_token.py once.
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Brevo: app.brevo.com → SMTP & API → API keys. Sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Resend: resend.com/api-keys. Without a verified domain it only mails you.
RESEND_API_KEY=
# RESEND_FROM=PlateletIQ <alerts@yourdomain.com>

# ── Telegram bot (phone alerts) ──────────────────────────────────────────────
# Create a bot with @BotFather. Then run scripts/setup_telegram_webhook.py once
# deployed; locally, leave TELEGRAM_WEBHOOK_SECRET empty and the app polls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Discord (network operations channel) ─────────────────────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# ── Observability ────────────────────────────────────────────────────────────
# Sentry: sentry.io → Project → Settings → Client Keys (DSN).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Better Stack Logs: telemetry.betterstack.com → Sources → Python source.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
# 1 = one JSON object per log line (default outside development).
# LOG_JSON=1
# Heartbeat (dead man's switch) per scheduled job — Better Stack or Healthchecks.io.
HEARTBEAT_URL_EXPIRY_SWEEP=
HEARTBEAT_URL_DAILY_DIGEST=
HEARTBEAT_URL_FORECAST_REFRESH=
# UptimeRobot public status page, linked from the Cloud services screen.
STATUS_PAGE_URL=

# ── AWS Free Tier (deploy aws/plateletiq-aws.yaml first; values from its Outputs) ─
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_CUSTODY_TOPIC_ARN=
AWS_SNS_ALERTS_TOPIC_ARN=
AWS_S3_BUCKET=
# Only if you verified a sender identity in SES:
AWS_SES_SENDER=

# ── Courier: Shiprocket ──────────────────────────────────────────────────────
# TRANSPORT_MODE=live plus credentials books real shipments. Anything else
# simulates the courier; the UI and /health both say which is in effect.
TRANSPORT_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BILLING_EMAIL=
# Shared secret for POST /api/v1/webhooks/shiprocket. Intake refused while unset.
SHIPROCKET_WEBHOOK_TOKEN=

# ── Routing ──────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org

# ── Facility coordinates ─────────────────────────────────────────────────────
GEOCODE_FACILITIES=0

# ── OTP policy ───────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=1800
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=8
